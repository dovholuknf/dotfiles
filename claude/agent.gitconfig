# Git config for the agent account (claude), shared by every machine. Each machine's ~/.gitconfig includes this file
# and adds only what depends on where things live there:
#
#   [include]
#       path = <dotfiles>/claude/agent.gitconfig
#   [core]
#       hooksPath = <dotfiles>/githooks/agent      # holds commits to claude/* and refuses LLM attribution
#   [user]
#       signingkey = <home>/.ssh/id_ed25519_sign.pub
#
# Settings in ~/.gitconfig after the include win over the same settings here. core.excludesfile below expects
# ~/.gitignore_global to be a symlink to claude/agent.gitignore_global in this repo.

[core]
	autocrlf = false
	excludesfile = ~/.gitignore_global
[user]
	name = dovholuknf
	email = 46322585+dovholuknf@users.noreply.github.com
[gpg]
	format = ssh
[commit]
	gpgsign = true
[safe]
	directory = *
[alias]
	dnp = "!git --no-pager diff"
	co = checkout
	sts = status
	st = status --ignore-submodules
	rs = restore --staged
	br = branch
	l = "log --graph --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(green)%s%C(reset) %C(bold blue)<%an>%C(reset) %C(bold yellow)%d%C(reset)' --abbrev-commit --date=relative"
	ll = "log --graph --decorate --abbrev-commit --date=relative"
	lg = "log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative"
	lg1 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
	lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
	lg3 = !"git lg1"
	info = "config --get remote.origin.url"
	supdate = "submodule update --remote --merge"
	whoami = "config user.name"
	gpr = pull --recurse-submodules
	suri = submodule update --init --recursive
	smerge = merge --squash --no-commit
	brls = branch --sort=-committerdate
	undocommit = reset --soft HEAD~1
	diff-from-main = "!sh -c 'git diff main...$1' -"
	bbd = for-each-ref --sort=-committerdate --format='%(committerdate:short) %(refname:short)' refs/heads/
	fat = fetch --all --tags
