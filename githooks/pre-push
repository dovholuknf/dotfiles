#!/bin/sh
# Global pre-push guard.
#
# Refuse to update main/master on ANY remote unless the push is explicitly
# confirmed at the terminal (or GIT_ALLOW_MAIN=1 is set for scripted pushes).
#
# Client-side only. Bypassable with `git push --no-verify`, so this is a guard
# against fat-finger pushes, not a security control. Server-side branch
# protection is the real enforcement.
#
# Install (one time, clint's account):
#   git config --global core.hooksPath "D:/git/github/dovholuknf/dotfiles/githooks"
#
# Note: core.hooksPath overrides each repo's own .git/hooks. To avoid silently
# disabling per-repo hooks (pre-commit framework, etc.), this chains to a repo
# -local pre-push if one exists. A repo that sets its OWN core.hooksPath (husky
# points it at .husky) wins over this global one, so the guard is skipped there.

remote="$1"

# Buffer the ref list so it can be inspected here and replayed to a chained hook.
input=$(cat)

blocked=''
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master) blocked="$remote_ref" ;;
    esac
done <<EOF
$input
EOF

if [ -n "$blocked" ]; then
    # Allowlist: repos you routinely push main to skip the prompt. Two ways in:
    #   per-repo:  git config hooks.allowMainPush true   (run inside that clone)
    #   central:   add "host/org/repo" (one per line) to the allowlist file, default
    #              ~/.config/git/main-push-allowlist (override with hooks.mainPushAllowFile).
    # The id is derived from the remote URL git passed as $2, normalized to host/org/repo.
    allowfile=$(git config --get hooks.mainPushAllowFile 2>/dev/null)
    [ -z "$allowfile" ] && allowfile="$HOME/.config/git/main-push-allowlist"
    id=$(printf '%s' "$2" | sed -E -e 's#^[a-z]+://##' -e 's#^git@##' -e 's#:#/#' -e 's#\.git$##' -e 's#/+$##')

    allow_main=0
    [ "$(git config --type=bool --get hooks.allowMainPush 2>/dev/null)" = "true" ] && allow_main=1
    [ "$allow_main" = "0" ] && [ -n "$id" ] && [ -f "$allowfile" ] && grep -qxF "$id" "$allowfile" 2>/dev/null && allow_main=1

    if [ "$allow_main" = "1" ]; then
        :   # this repo is allowlisted for main pushes
    elif [ "$GIT_ALLOW_MAIN" = "1" ]; then
        :   # explicit one-shot override
    elif [ -e /dev/tty ]; then
        printf '\n  BLOCKED: this push updates %s on "%s".\n' "$blocked" "$remote" > /dev/tty
        printf '  allowlist: %s\n    entry: %s\n' "$allowfile" "$id" > /dev/tty
        printf "  Type 'yes' to allow once, 'always' to add it to the allowlist, anything else aborts: " > /dev/tty
        read -r answer < /dev/tty
        case "$answer" in
            always|ALWAYS|a|A)
                if [ -n "$id" ]; then
                    mkdir -p "$(dirname "$allowfile")" 2>/dev/null
                    if ! { [ -f "$allowfile" ] && grep -qxF "$id" "$allowfile" 2>/dev/null; }; then
                        printf '%s\n' "$id" >> "$allowfile"
                    fi
                    printf "  added '%s' to %s -- future main pushes here skip this prompt.\n" "$id" "$allowfile" > /dev/tty
                else
                    printf '  could not derive a repo id from the remote; allowed once instead.\n' > /dev/tty
                fi
                ;;
            yes|YES|y|Y) printf '  allowed once.\n' > /dev/tty ;;
            *)           printf '  aborted.\n' > /dev/tty; exit 1 ;;
        esac
    else
        printf 'pre-push: refusing to update %s (no terminal; allowlist it or set GIT_ALLOW_MAIN=1)\n' "$blocked" 1>&2
        exit 1
    fi
fi

# Signature gate: every pushed commit on a branch ref must verify with
# git verify-commit, which exits non-zero on a bad or missing signature. clint
# signs with GPG and has no SSH allowed-signers, so claude's SSH-signed commits
# and unsigned commits both fail here, while clint's GPG-signed commits pass.
#
# This gate NEVER auto-skips. The one way past it without a valid signature is to
# turn it off on purpose, and it says so on every push so it is never silently off:
#   disable:   git config --global hooks.signedPush off
#   re-enable: git config --global --unset hooks.signedPush
if [ "$(git config --get hooks.signedPush)" = "off" ]; then
    printf 'pre-push: signed-push gate is OFF (hooks.signedPush=off). re-enable: git config --global --unset hooks.signedPush\n' 1>&2
else
    bad=''
    while read -r l_ref l_sha r_ref r_sha; do
        case "$r_ref" in refs/heads/*) ;; *) continue ;; esac
        case "$l_sha" in *[!0]*) ;; *) continue ;; esac       # branch deletion, nothing to verify
        # Verify only commits this push introduces that are not already on ANY
        # remote-tracking ref. $r_sha..$l_sha looks tighter but breaks on a
        # force-push after rebasing onto main: it then spans every upstream commit
        # main advanced by, none of them yours to sign. --not --remotes scopes to
        # what is genuinely new, which is all a client-side gate needs to vouch for.
        range="$l_sha --not --remotes"
        for c in $(git rev-list $range 2>/dev/null); do
            if ! git verify-commit "$c" 2>/dev/null; then
                bad="$bad $c"
            fi
        done
    done <<EOF
$input
EOF

    if [ -n "$bad" ]; then
        printf '\n  BLOCKED: these commits are not signed by a trusted key:\n' 1>&2
        for c in $bad; do printf '    %s\n' "$c" 1>&2; done
        printf '  Only clint-signed commits may be pushed. Sign them (amend or rebase), or:\n' 1>&2
        printf '    bypass once:  git push --no-verify\n' 1>&2
        printf '    turn off:     git config --global hooks.signedPush off   (re-enable: git config --global --unset hooks.signedPush)\n' 1>&2
        exit 1
    fi
fi

# Chain to the repo's own pre-push (found via --git-dir so it ignores the global
# hooksPath), replaying the buffered ref list on its stdin.
local_hook="$(git rev-parse --git-dir)/hooks/pre-push"
if [ -x "$local_hook" ] && [ "$local_hook" != "$0" ]; then
    printf '%s\n' "$input" | "$local_hook" "$@"
    exit $?
fi

exit 0
